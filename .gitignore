__pycache__/
*.py[cod]
.venv/
venv/

# Datasets — re-download with `python -m benchmark.prepare`
data/

# PBS job output -- submit_aurora.sh directs these into logs/, but catch
# stragglers from ad-hoc qsubs too. logs/ itself is kept so PBS has a
# directory to open its output files in on a fresh clone.
*.o[0-9]*
*.e[0-9]*
logs/*
!logs/.gitkeep

# Keep results/ tracked (they are the deliverable) but not scratch files
results/*.tmp
*.csv

# Profiler traces -- hundreds of MB, and regenerable with --profile
results/traces/

# AIPerf writes the whole request corpus and a per-request trace beside its
# summary. Keep profile_export_aiperf.json, idle.json and summary.* -- those are
# the deliverable and are small; drop the rest, which is ~700 KB per sweep point
# and says nothing a re-run would not.
results/aiperf/*/*/profile_export.jsonl
results/aiperf/*/*/gpu_telemetry_export.jsonl
results/aiperf/*/*/inputs.json
results/aiperf/*/*/logs/
results/aiperf/*/vllm.log
results/aiperf/*/aiperf-c*.log

# The venv for the inference sweep (vLLM + aiperf), built per machine.
.venv-aiperf/
.venv-aiperf-aurora/
.hf-cache/

# vLLM's model-info cache on Aurora, and the ALCF workaround script that fills
# it. Rebuildable with scripts/vllm_prepopulate_aurora.sh, and the script is
# fetched from ALCF's frameworks-sdk rather than vendored so it stays theirs.
.vllm_cache/
vllm_build_all_modelinfo_caches.py
